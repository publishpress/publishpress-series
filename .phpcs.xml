<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="PublishPress"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
    <description>Apply Coding Standards to all the plugin files</description>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="cache"/>
    <ini name="memory_limit" value="256M"/>
    <arg name="basepath" value="."/>
    <arg name="parallel" value="8"/>
    <arg value="ps"/>

    <file>.</file>
    <exclude-pattern>/.cursor/*</exclude-pattern>
    <exclude-pattern>/.github/*</exclude-pattern>
    <exclude-pattern>/.idea/*</exclude-pattern>
    <exclude-pattern>/.vscode/*</exclude-pattern>
    <exclude-pattern>/.wordpress-org/*</exclude-pattern>
    <exclude-pattern>/bin/*</exclude-pattern>
    <exclude-pattern>/dev-workspace-cache/*</exclude-pattern>
    <exclude-pattern>/dist/*</exclude-pattern>
    <exclude-pattern>/languages/*</exclude-pattern>
    <exclude-pattern>/lib/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/tests-old/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/vendor/*</exclude-pattern>

    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength.TooLong" />
        <!-- Legacy WordPress plugin APIs intentionally keep historical snake_case names and global classes. -->
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps" />
        <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace" />
        <exclude name="PSR1.Classes.ClassDeclaration.MultipleClasses" />
        <exclude name="PSR2.Methods.MethodDeclaration.Underscore" />
        <exclude name="PSR2.Classes.PropertyDeclaration.ScopeMissing" />
        <exclude name="PSR2.Classes.PropertyDeclaration.VarUsed" />
        <exclude name="PSR12.Properties.ConstantVisibility.NotFound" />
        <exclude name="Squiz.Classes.ValidClassName.NotCamelCaps" />
        <exclude name="Squiz.Scope.MethodScope.Missing" />
        <exclude name="Squiz.PHP.CommentedOutCode.Found" />
        <exclude name="PSR12.Files.FileHeader.HeaderPosition" />
        <exclude name="PSR12.Files.FileHeader.IncorrectGrouping" />
        <exclude name="PSR12.Files.FileHeader.IncorrectOrder" />
        <exclude name="PSR12.Files.FileHeader.SpacingAfterBlock" />
    </rule>
    <rule ref="WordPressVIPMinimum">
        <exclude name="WordPress.DateTime.RestrictedFunctions.date_date" />
        <exclude name="WordPress.WP.GlobalVariablesOverride.Prohibited" />
        <exclude name="WordPress.DB.DirectDatabaseQuery.SchemaChange" />
        <exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery" />
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols" />
    </rule>
    <rule ref="WordPress-VIP-Go"/>
    <rule ref="VariableAnalysis"/>
    <rule ref="PublishPressStandards"/>

    <rule ref="WordPress.Security.EscapeOutput.OutputNotEscaped">
        <!-- Legacy renderers/templates build HTML from escaped fragments; keep this scoped so new files still fail. -->
        <exclude-pattern>/addons/grouping/legacy-includes.php</exclude-pattern>
        <exclude-pattern>/addons/grouping/orgseries-grouping-template-tags.php</exclude-pattern>
        <exclude-pattern>/addons/grouping/theme/twenty-ten/groups-template.php</exclude-pattern>
        <exclude-pattern>/addons/post-details/classes/SeriesPostDetailsRenderer.php</exclude-pattern>
        <exclude-pattern>/addons/post-details/includes/class-admin-ui.php</exclude-pattern>
        <exclude-pattern>/addons/post-details/includes/class-ajax.php</exclude-pattern>
        <exclude-pattern>/addons/post-details/includes/class-preview.php</exclude-pattern>
        <exclude-pattern>/addons/post-list-box/classes/PostListBoxRenderer.php</exclude-pattern>
        <exclude-pattern>/addons/post-list-box/includes/class-admin-ui.php</exclude-pattern>
        <exclude-pattern>/addons/post-list-box/includes/class-preview.php</exclude-pattern>
        <exclude-pattern>/addons/post-navigation/classes/PostNavigationRenderer.php</exclude-pattern>
        <exclude-pattern>/addons/post-navigation/includes/class-admin-ui.php</exclude-pattern>
        <exclude-pattern>/addons/post-navigation/includes/class-ajax.php</exclude-pattern>
        <exclude-pattern>/addons/post-navigation/includes/class-preview.php</exclude-pattern>
        <exclude-pattern>/inc/settings/settings-upgrade.php</exclude-pattern>
        <exclude-pattern>/inc/settings/tab-legacy.php</exclude-pattern>
        <exclude-pattern>/inc/settings/tab-post-types.php</exclude-pattern>
        <exclude-pattern>/inc/settings/tab-pro-features.php</exclude-pattern>
        <exclude-pattern>/orgSeries-admin.php</exclude-pattern>
        <exclude-pattern>/orgSeries-manage.php</exclude-pattern>
        <exclude-pattern>/src/libraries/edd/PluginUpdater.php</exclude-pattern>
    </rule>

    <!-- Legacy database/query patterns are audited separately; keep PHPCS focused on blocking security and syntax issues. -->
    <rule ref="WordPress.DB.DirectDatabaseQuery.NoCaching"><severity>0</severity></rule>
    <rule ref="WordPress.DB.SlowDBQuery.slow_db_query_tax_query"><severity>0</severity></rule>
    <rule ref="WordPress.DB.SlowDBQuery.slow_db_query_meta_query"><severity>0</severity></rule>
    <rule ref="WordPress.WP.CronInterval.ChangeDetected"><severity>0</severity></rule>
    <rule ref="WordPressVIPMinimum.Functions.CheckReturnValue.DirectFunctionCall"><severity>0</severity></rule>
    <rule ref="WordPressVIPMinimum.Functions.RestrictedFunctions.flush_rules_flush_rules"><severity>0</severity></rule>
    <rule ref="WordPressVIPMinimum.Functions.RestrictedFunctions.flush_rewrite_rules_flush_rewrite_rules"><severity>0</severity></rule>
    <rule ref="WordPressVIPMinimum.Functions.RestrictedFunctions.url_to_postid_url_to_postid"><severity>0</severity></rule>
    <rule ref="WordPressVIPMinimum.Functions.RestrictedFunctions.wp_remote_get_wp_remote_get"><severity>0</severity></rule>
    <rule ref="WordPressVIPMinimum.Hooks.PreGetPosts.PreGetPosts"><severity>0</severity></rule>
    <rule ref="WordPressVIPMinimum.Performance.FetchingRemoteData.FileGetContentsUnknown"><severity>0</severity></rule>
    <rule ref="WordPressVIPMinimum.Performance.NoPaging.posts_per_page_numberposts"><severity>0</severity></rule>
    <rule ref="WordPressVIPMinimum.Performance.NoPaging.posts_per_page_posts_per_page"><severity>0</severity></rule>
    <rule ref="WordPressVIPMinimum.Performance.RemoteRequestTimeout.timeout_timeout"><severity>0</severity></rule>
    <rule ref="WordPressVIPMinimum.Performance.WPQueryParams.PostNotIn_exclude"><severity>0</severity></rule>
    <rule ref="VariableAnalysis.CodeAnalysis.VariableAnalysis.VariableRedeclaration"><severity>0</severity></rule>
    <rule ref="WordPressVIPMinimum.Hooks.AlwaysReturnInFilter.MissingReturnStatement"><severity>0</severity></rule>
</ruleset>
