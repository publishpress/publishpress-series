msgstr "Ezek a mezők csak a sorozatokra vonatkoznak, nem a Sorozat Kategóriákra."

#: includes-core/Mcp/Content.php:239
msgid "Use an existing category parent without a cycle."
msgstr "Használjon meglévő kategória szülőt ciklus nélkül."

#: includes-core/Mcp/Content.php:258
